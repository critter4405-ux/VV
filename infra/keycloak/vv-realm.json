{
  "realm": "vv",
  "enabled": true,
  "displayName": "VV (Stage 0, synthetisch)",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA256",
  "passwordPolicy": "length(12) and notUsername and passwordHistory(3)",
  "bruteForceProtected": true,
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "enabled": true,
      "defaultAction": true
    }
  ],
  "clients": [
    {
      "clientId": "vv-web",
      "name": "VV Web/API (OIDC-Client)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "secret": "change_me_dev_only",
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "roles-flat",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "aud-vv-web",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "vv-web",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "vv-worker",
      "name": "VV Worker (Client-Credentials, technische Identität)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "change_me_dev_only"
    }
  ],
  "roles": {
    "realm": [
      { "name": "mandanten-admin" },
      { "name": "vorstand" },
      { "name": "kassier" },
      { "name": "kassapruefer" },
      { "name": "kinderschutzbeauftragte" },
      { "name": "trainer" },
      { "name": "mitglied" }
    ]
  },
  "users": [
    {
      "username": "demo-vorstand",
      "enabled": true,
      "email": "demo-vorstand@example.org",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Vorstand",
      "attributes": { "tenant_id": ["00000000-0000-0000-0000-0000000000aa"] },
      "realmRoles": ["vorstand", "mitglied"],
      "credentials": [
        { "type": "password", "value": "change_me_dev_only", "temporary": false }
      ]
    }
  ]
}
