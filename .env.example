# VV — Beispiel-Umgebung (Stage 0). KOPIEREN nach .env; .env NIE committen.
# Alle Werte hier sind synthetische Platzhalter — keine echten Geheimnisse.

# --- Postgres (ADR-01) ---
# Bootstrap-Superuser (nur für initdb/Migrationen) — NICHT die App-Rolle (WP1/Review #2).
POSTGRES_USER=vv_bootstrap
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=vv
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# App-Rolle Web/API: NOSUPERUSER + NOBYPASSRLS, besitzt keine Tabellen (RLS greift).
VV_APP_USER=vv_app
VV_APP_PASSWORD=change_me_dev_only
DATABASE_URL=postgres://vv_app:change_me_dev_only@postgres:5432/vv

# Worker-Rolle: eigene technische Identität (vv_worker) — NUR sie darf Outbox zustellen + pgboss.
VV_WORKER_USER=vv_worker
VV_WORKER_PASSWORD=change_me_dev_only
WORKER_DATABASE_URL=postgres://vv_worker:change_me_dev_only@postgres:5432/vv

# --- Keycloak (ADR-03: OIDC, TOTP-2FA) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_dev_only
KEYCLOAK_REALM=vv
OIDC_ISSUER=http://keycloak:8080/realms/vv
OIDC_CLIENT_ID=vv-web
OIDC_CLIENT_SECRET=change_me_dev_only

# --- Worker: eigene technische Identität (nicht vv-web) ---
WORKER_OIDC_CLIENT_ID=vv-worker
WORKER_OIDC_CLIENT_SECRET=change_me_dev_only

# --- MinIO (ADR-08) ---
MINIO_ROOT_USER=vv_minio
MINIO_ROOT_PASSWORD=change_me_dev_only
S3_ENDPOINT=http://minio:9000
S3_BUCKET=vv-dev
S3_REGION=at-1

# --- Worker / Jobs (ADR-06) ---
WORKER_CONCURRENCY=2

# --- KI-Gateway (ADR-07): kein Personenbezug ans Modell; kein Non-AT/EU-Fallback (Fail-Fast) ---
MODEL_PROVIDER=eu-api-stub
MODEL_API_BASE=
MODEL_API_KEY=

# --- Datenschutz-Guard: nur synthetische Daten in Dev/CI ---
VV_DATA_MODE=synthetic
