# VV — Beispiel-Umgebung (Stage 0). KOPIEREN nach .env; .env NIE committen.
# Alle Werte hier sind synthetische Platzhalter — keine echten Geheimnisse.

# --- Postgres (ADR-01: RLS-Mandanten) ---
POSTGRES_USER=vv_app
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=vv
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# App nutzt eine DB-Rolle OHNE BYPASSRLS (ADR-01)
DATABASE_URL=postgres://vv_app:change_me_dev_only@postgres:5432/vv

# --- Keycloak (ADR-03: OIDC, TOTP-2FA) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_dev_only
KEYCLOAK_REALM=vv
OIDC_ISSUER=http://keycloak:8080/realms/vv
OIDC_CLIENT_ID=vv-web
OIDC_CLIENT_SECRET=change_me_dev_only

# --- MinIO (ADR-08: S3-kompatibel, Dateien) ---
MINIO_ROOT_USER=vv_minio
MINIO_ROOT_PASSWORD=change_me_dev_only
S3_ENDPOINT=http://minio:9000
S3_BUCKET=vv-dev
S3_REGION=at-1

# --- Worker / Jobs (ADR-06: pg-boss) ---
WORKER_CONCURRENCY=2

# --- KI-Gateway (ADR-07: Pseudonymisierung, externe EU-API) ---
# Kein Personenbezug ans Modell. Im Stage-0-Skeleton nur Platzhalter.
MODEL_PROVIDER=eu-api-stub
MODEL_API_BASE=
MODEL_API_KEY=

# --- Datenschutz-Guard ---
# harte Zusicherung: nur synthetische Daten in Dev/CI
VV_DATA_MODE=synthetic
